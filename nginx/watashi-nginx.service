# watashi v12.3.40dev: the old project name was taken out of this file (names, paths and links only)
[Unit]
Description=watashi-nginx - high performance web server
Documentation=https://nginx.org/en/docs/
After=network-online.target remote-fs.target nss-lookup.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=/run/watashi-nginx.pid
ExecStartPre=/opt/watashi-manager/nginx/pre-start.sh
ExecStart=/usr/sbin/nginx -c /opt/watashi-manager/nginx/nginx.conf
# -g "daemon off;"
ExecReload=/bin/sh -c "/bin/kill -s HUP $(/bin/cat /run/watashi-nginx.pid)"
ExecStop=/bin/sh -c "/bin/kill -s TERM $(/bin/cat /run/watashi-nginx.pid)"
#ExecReload=/bin/kill -s HUP $MAINPID
#ExecStop=/bin/kill -s TERM $MAINPID
RestartSec=3
Restart=always
[Install]
WantedBy=multi-user.target
