[Unit]
Description=Watashi WARP (warp-plus engine)
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hiddify-manager/other/warp/warpplus/
ExecStart=/bin/bash /opt/hiddify-manager/other/warp/warpplus/engine-start.sh
Restart=always
RestartSec=5
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
