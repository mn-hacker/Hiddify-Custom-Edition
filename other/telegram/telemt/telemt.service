[Unit]
Description=telemt - Telegram MTProto proxy (watashi v12.2.53)
Documentation=https://github.com/telemt/telemt
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=/opt/hiddify-manager/other/telegram/telemt
ExecStartPre=/bin/bash -c 'test -x /opt/hiddify-manager/other/telegram/telemt/telemt || { echo "telemt binary is missing"; exit 1; }'
ExecStartPre=/bin/bash -c 'test -f /opt/hiddify-manager/other/telegram/telemt/telemt.toml || { echo "telemt.toml is missing"; exit 1; }'
ExecStart=/opt/hiddify-manager/other/telegram/telemt/telemt /opt/hiddify-manager/other/telegram/telemt/telemt.toml
Restart=on-failure
RestartSec=10
LimitNOFILE=65536
DynamicUser=true
# watashi v12.2.130k: the listener is on 127.0.0.1:1001 and anything below 1024 is
# privileged, so the dynamic account was refused with "Permission denied" and the
# telegram proxy never came up. haproxy and other/telegram/tgo/mtg.toml.j2 both
# point at 1001, so the port stays and the unit gets the single capability that
# opening it needs. NoNewPrivileges below still holds: an ambient capability is
# granted by systemd, not gained by the process.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=telemt
NoNewPrivileges=true
StandardOutput=file:/opt/hiddify-manager/log/system/telegram.out.log
StandardError=file:/opt/hiddify-manager/log/system/telegram.err.log

[Install]
WantedBy=multi-user.target
