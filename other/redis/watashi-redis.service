# watashi v12.3.40dev: the old project name was taken out of this file (names, paths and links only)
[Unit]
Description=Watashi Redis
After=network.target
Documentation=http://redis.io/documentation, man:redis-server(1)
# Never latch into the 'failed' state: with Restart=always, keep retrying forever so a
# transient redis crash self-heals instead of dragging watashi-panel (Requires=) and
# watashi-panel-background-tasks (BindsTo=) down with it.
StartLimitIntervalSec=0

[Service]
Type=notify
ExecStart=/usr/bin/redis-server /opt/watashi-manager/other/redis/redis.conf --supervised systemd --daemonize no
PIDFile=/var/run/watashi-redis-server.pid
TimeoutStopSec=0
Restart=always
User=redis
Group=redis
RuntimeDirectory=watashi-redis
RuntimeDirectoryMode=2755

UMask=007
PrivateTmp=yes
LimitNOFILE=65535
PrivateDevices=yes
ProtectHome=yes
ReadOnlyDirectories=/
ReadWritePaths=-/var/lib/redis
ReadWritePaths=-/var/log/redis
ReadWritePaths=-/var/run/redis
ReadWritePaths=-/opt/watashi-manager/other/redis
ReadWritePaths=-/opt/watashi-manager/log/system

NoNewPrivileges=true
CapabilityBoundingSet=CAP_SETGID CAP_SETUID CAP_SYS_RESOURCE
MemoryDenyWriteExecute=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# redis-server can write to its own config file when in cluster mode so we
# permit writing there by default. If you are not using this feature, it is
# recommended that you replace the following lines with "ProtectSystem=full".
ProtectSystem=true
ReadWriteDirectories=-/etc/redis

[Install]
WantedBy=multi-user.target
