# watashi v12.2.103: the mieru server is configured over its own socket.
# This file is rendered to run.sh by common/jinja.py before it is run.
#
# What the mita binary really does, checked against 3.36.1 and not guessed:
#   mita run                 brings up the daemon and the RPC socket only.
#                            No proxy port is opened by this alone.
#   mita apply config FILE   hands a json configuration to that daemon. The
#                            daemon hashes every password and stores the whole
#                            thing in MITA_CONFIG_FILE.
#   mita start               opens the listeners. Without a configuration it
#                            refuses with "server config is empty".
#   mita reload              re-reads the stored configuration while the
#                            listeners stay up, so a user added or removed
#                            does not drop everybody else's connection.
#
# The accepted server fields were probed one by one on the same binary:
# portBindings (port or portRange plus protocol), users (name, password,
# quotas), loggingLevel, mtu, dns and egress. multiplexing, handshakeMode and
# metricsLoggingInterval are client-side or newer names - mita answers
# 'unknown field "multiplexing"' - so the panel's mieru_multiplexing and
# mieru_handshake keys belong in the client link, never in this file.

source /opt/hiddify-manager/common/utils.sh
cd /opt/hiddify-manager/other/mieru

MITA=/opt/hiddify-manager/other/mieru/mita
export MITA_CONFIG_FILE=/opt/hiddify-manager/other/mieru/server.conf.pb
export MITA_UDS_PATH=/opt/hiddify-manager/other/mieru/mita.sock

if [ ! -x "$MITA" ]; then
    echo "watashi: the mita binary is not on the disk, mieru was not started"
    exit 0
fi

{% set tcp_raw = (hconfigs.get('mieru_tcp_ports') or '')|string %}
{% set udp_raw = (hconfigs.get('mieru_udp_ports') or '')|string %}
{% set tcp_list = tcp_raw.replace(' ', ',').split(',')|select|list %}
{% set udp_list = udp_raw.replace(' ', ',').split(',')|select|list %}
{% set mieru_users = users|selectattr('uuid')|list %}

{% if not tcp_list and not udp_list %}
echo "watashi: no mieru port is configured, so there is nothing to listen on"
exit 0
{% endif %}
{% if not mieru_users %}
echo "watashi: no user has a uuid, so mieru would accept nobody"
exit 0
{% endif %}

umask 077

# The whole configuration is written from scratch on every apply. A user whose
# access ended has to lose the line, and editing lines in place is a far
# easier thing to get wrong than writing the currently valid list.
cat > server.json <<'WS_MITA_END'
{
  "portBindings": [
{% set binds = [] %}
{%- for p in tcp_list %}{% set _ = binds.append(('TCP', p.strip())) %}{% endfor %}
{%- for p in udp_list %}{% set _ = binds.append(('UDP', p.strip())) %}{% endfor %}
{%- for proto, p in binds %}
    {% if '-' in p %}{ "portRange": "{{ p }}", "protocol": "{{ proto }}" }{% else %}{ "port": {{ p }}, "protocol": "{{ proto }}" }{% endif %}{{ "," if not loop.last else "" }}
{%- endfor %}
  ],
  "users": [
{%- for u in mieru_users %}
    { "name": "{{ u['uuid'] }}", "password": "{{ u['uuid'] }}" }{{ "," if not loop.last else "" }}
{%- endfor %}
  ],
  "loggingLevel": "WARN",
  "mtu": 1400
}
WS_MITA_END
chmod 600 server.json

mkdir -p /opt/hiddify-manager/log/system

# watashi v12.2.113: the daemon is restarted, not conditionally started.
# "is-active" is false for a unit in failed state as well, and "start" on a
# failed unit inside its rate limit window does nothing at all; reset-failed
# plus restart is the only pair that comes back from both states.
systemctl daemon-reload 2>/dev/null || true
systemctl enable watashi-mita.service >/dev/null 2>&1 || true
systemctl reset-failed watashi-mita.service 2>/dev/null || true
systemctl restart watashi-mita.service >/dev/null 2>&1 || true

# watashi v12.2.113: this used to wait for the socket *file* to appear. A
# socket left behind by a daemon that died satisfied that test immediately,
# the configuration was then handed to nobody and mita answered "mita server
# daemon is not running; please run sudo systemctl restart mita" - the exact
# line the install log carried. The daemon is asked instead: "mita status"
# only answers IDLE or RUNNING when the RPC really is served.
ws_mita_ready=0
for _i in $(seq 1 40); do
    if $MITA status 2>/dev/null | grep -qE 'IDLE|RUNNING'; then
        ws_mita_ready=1
        break
    fi
    sleep 0.5
done
if [ "$ws_mita_ready" != "1" ]; then
    # watashi v12.2.113: say why, in the apply log itself. Up to now the only
    # trace was one line of ours, and the reason lived in two places nobody
    # was asked to look at.
    echo "watashi: the mita daemon did not answer on $MITA_UDS_PATH"
    echo "watashi: unit is $(systemctl is-active watashi-mita.service 2>/dev/null), enabled=$(systemctl is-enabled watashi-mita.service 2>/dev/null)"
    if [ -s /opt/hiddify-manager/log/system/mieru.err.log ]; then
        echo "watashi: last lines of log/system/mieru.err.log:"
        tail -5 /opt/hiddify-manager/log/system/mieru.err.log | sed 's/^/watashi:   /'
    fi
    journalctl -u watashi-mita --no-pager -n 10 2>/dev/null | tail -10 | sed 's/^/watashi:   /'
    exit 0
fi

# watashi v12.2.113: upstream issue #285 - applying a configuration whose
# port is already taken by another process makes mita fail, and the message
# it gives does not name the port. The ports are known here, so the clash is
# named before the apply instead of being guessed afterwards.
ws_mita_port_check() { # proto entry
    local proto=$1 entry=$2 flag=-t holder
    [ "$proto" = udp ] && flag=-u
    command -v ss >/dev/null 2>&1 || return 0
    case $entry in *-*) return 0 ;; esac
    holder=$(ss -H -lnp $flag "sport = :$entry" 2>/dev/null | grep -v '"mita"' | head -1)
    if [ -n "$holder" ]; then
        echo "watashi: $proto port $entry is already held by another process, mieru will not be able to listen on it"
        echo "watashi:   $holder"
    fi
}
{% for p in tcp_list %}ws_mita_port_check tcp "{{ p.strip() }}"
{% endfor %}{% for p in udp_list %}ws_mita_port_check udp "{{ p.strip() }}"
{% endfor %}

if ! $MITA apply config server.json; then
    echo "watashi: mita refused the configuration, the running proxy was left alone"
    # watashi v12.2.113: the refusal reason is in mita's own log, so it is
    # copied into the apply log rather than left for a second round trip.
    if [ -s /opt/hiddify-manager/log/system/mieru.err.log ]; then
        tail -5 /opt/hiddify-manager/log/system/mieru.err.log | sed 's/^/watashi:   /'
    fi
    exit 0
fi

# A proxy that is already up is reloaded, which keeps live connections; one
# that is idle is started. Asking for the status first is what makes an apply
# on a busy server harmless.
if $MITA status 2>/dev/null | grep -q RUNNING; then
    $MITA reload >/dev/null 2>&1 || $MITA start >/dev/null 2>&1 || true
else
    $MITA start >/dev/null 2>&1 || true
fi
$MITA status 2>&1 | head -2

# The firewall is fed from the very same list the configuration was built
# from, so the two cannot drift apart. Ranges are written as one iptables
# rule; allow_port only understands a single port.
ws_mita_allow() { # proto entry
    local proto=$1 entry=$2
    if [[ $entry == *-* ]]; then
        add2iptables46 "INPUT -p $proto --dport ${entry/-/:} -j ACCEPT"
    else
        allow_port "$proto" "$entry"
    fi
}
{% for p in tcp_list %}ws_mita_allow tcp "{{ p.strip() }}"
{% endfor %}{% for p in udp_list %}ws_mita_allow udp "{{ p.strip() }}"
{% endfor %}save_firewall
