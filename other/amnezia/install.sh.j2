# watashi: the separate AmneziaWG system v12.2.62
# This file is rendered to install.sh by common/jinja.py before it is run.

source ../../common/utils.sh
source ./awg_utils.sh

if ! ws_awg_name_ok; then
    ws_awg_say "awg-quick would refuse the interface name $SERVER_AWG_NIC, so nothing was touched"
    exit 0
fi

if ! ws_awg_ready; then
    # watashi v12.2.130u: the repository below is a ppa, which only exists on
    # debian and ubuntu. On anything else apt-get is not there at all and
    # every line simply failed in the dark, ending in the vague "could not
    # be installed" below. The reason is named now.
    if ! command -v apt-get >/dev/null 2>&1; then
        ws_awg_say "this machine has no apt-get, and amneziawg ships as an ubuntu ppa. Install amneziawg and amneziawg-tools by hand, then switch amnezia on again."
        exit 0
    fi
    ws_awg_say "amneziawg is not on this machine yet, asking the amnezia repository for it"
    export DEBIAN_FRONTEND=noninteractive
    apt-get install -y software-properties-common >/dev/null 2>&1
    add-apt-repository -y ppa:amnezia/ppa >/dev/null 2>&1
    apt-get update -y >/dev/null 2>&1
    apt-get install -y "linux-headers-$(uname -r)" >/dev/null 2>&1
    apt-get install -y amneziawg amneziawg-tools >/dev/null 2>&1
fi

# watashi v12.2.130u: nothing else on this box serves amnezia, so if the tools are
# missing the script stops here and says so plainly, without taking any
# other protocol down with it.
if ! ws_awg_ready; then
    ws_awg_say "amneziawg could not be installed here. nothing was changed and no service was stopped."
    ws_awg_say "send the output of: apt-cache policy amneziawg amneziawg-tools"
    exit 0
fi

{% if hconfigs['wireguard_enable'] and (hconfigs.get('amnezia_ipv4') or hconfigs['wireguard_ipv4']) == hconfigs['wireguard_ipv4'] %}
# watashi v12.2.130am: amnezia owns amnezia_ipv4/ipv6 now, so this only fires on a
# panel that has not run the 157 migration yet and still hands both
# tunnels one range. Two interfaces on one subnet is a routing argument
# the kernel settles by luck.
ws_awg_say "warning: plain wireguard is on as well and this panel still gives both tunnels the same {{ hconfigs['wireguard_ipv4'] }} subnet. open the panel once so the database reaches version 157, then apply again."
{% endif %}

{% if not hconfigs.get('amnezia_private_key') %}
# watashi v12.2.130an: amnezia has a key pair of its own from db version 158 on.
# Until the panel has been restarted once the interface falls back to
# the wireguard key, which means one identity for two tunnels.
ws_awg_say "warning: this panel has no amnezia key pair yet, so the interface is being built with the plain wireguard key. restart hiddify-panel once so the database reaches version 158, then apply again."
{% endif %}

if ! ws_awg_headers_disguised "{{ hconfigs['amnezia_h1'] }}" "{{ hconfigs['amnezia_h2'] }}" "{{ hconfigs['amnezia_h3'] }}" "{{ hconfigs['amnezia_h4'] }}"; then
    ws_awg_say "warning: H1..H4 are still the four packet types plain wireguard uses, so the header is not disguised at all and simple matching still recognises this tunnel. open the panel once so the database is brought up to date, then apply again."
fi

SERVER_PUB_NIC="$(ip -4 route ls | grep default | grep -Po '(?<=dev )(\S+)' | head -1)"
AWG_PORT={{ hconfigs['amnezia_port'] }}

umask 077
mkdir -p "$AWG_DIR"
chmod 700 "$AWG_DIR"

# The interface is described from scratch on every apply. run.sh appends the
# peers afterwards, which is why nothing below this line mentions a user.
systemctl stop "$AWG_UNIT" >/dev/null 2>&1

cat >"$AWG_CONF" <<EOF
[Interface]
Address = {{ hconfigs.get('amnezia_ipv4') or hconfigs['wireguard_ipv4'] }}/16, {{ hconfigs.get('amnezia_ipv6') or hconfigs['wireguard_ipv6'] }}/90
ListenPort = ${AWG_PORT}
PrivateKey = {{ hconfigs.get('amnezia_private_key') or hconfigs['wireguard_private_key'] }}
MTU = 1280
Jc = {{ hconfigs['amnezia_jc'] }}
Jmin = {{ hconfigs['amnezia_jmin'] }}
Jmax = {{ hconfigs['amnezia_jmax'] }}
S1 = {{ hconfigs['amnezia_s1'] }}
S2 = {{ hconfigs['amnezia_s2'] }}
H1 = {{ hconfigs['amnezia_h1'] }}
H2 = {{ hconfigs['amnezia_h2'] }}
H3 = {{ hconfigs['amnezia_h3'] }}
H4 = {{ hconfigs['amnezia_h4'] }}
PostUp = iptables -I INPUT -p udp --dport ${AWG_PORT} -j ACCEPT
PostUp = iptables -I FORWARD -i ${SERVER_PUB_NIC} -o ${SERVER_AWG_NIC} -j ACCEPT
PostUp = iptables -I FORWARD -i ${SERVER_AWG_NIC} -j ACCEPT
PostUp = iptables -t nat -A POSTROUTING -o ${SERVER_PUB_NIC} -j MASQUERADE
PostUp = ip6tables -I FORWARD -i ${SERVER_AWG_NIC} -j ACCEPT
PostUp = ip6tables -t nat -A POSTROUTING -o ${SERVER_PUB_NIC} -j MASQUERADE
PostDown = iptables -D INPUT -p udp --dport ${AWG_PORT} -j ACCEPT
PostDown = iptables -D FORWARD -i ${SERVER_PUB_NIC} -o ${SERVER_AWG_NIC} -j ACCEPT
PostDown = iptables -D FORWARD -i ${SERVER_AWG_NIC} -j ACCEPT
PostDown = iptables -t nat -D POSTROUTING -o ${SERVER_PUB_NIC} -j MASQUERADE
PostDown = ip6tables -D FORWARD -i ${SERVER_AWG_NIC} -j ACCEPT
PostDown = ip6tables -t nat -D POSTROUTING -o ${SERVER_PUB_NIC} -j MASQUERADE
EOF
chmod 600 "$AWG_CONF"

echo "net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1" >"/etc/sysctl.d/${SERVER_AWG_NIC}.conf"
if [ "$MODE" != "docker" ]; then
    sysctl --system >/dev/null 2>&1
fi

systemctl enable "$AWG_UNIT" >/dev/null 2>&1
if systemctl start "$AWG_UNIT" >/dev/null 2>&1; then
    ws_awg_say "$SERVER_AWG_NIC is up on udp ${AWG_PORT}"
else
    ws_awg_say "$SERVER_AWG_NIC refused to start; systemctl status $AWG_UNIT and journalctl -u $AWG_UNIT will say why"
fi
