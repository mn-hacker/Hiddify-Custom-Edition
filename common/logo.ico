#!/bin/bash
# Watashi v12.2.37 - the mark we print when a run ends well
WS_TUI_FILE="/opt/hiddify-manager/common/watashi_tui.sh"
if [ ! -f "$WS_TUI_FILE" ]; then
    WS_TUI_FILE="$(dirname "$0")/watashi_tui.sh"
fi
if [ -f "$WS_TUI_FILE" ]; then
    source "$WS_TUI_FILE"
    echo
    ws_banner
    ws_brand_line
    ws_tag_line
    echo
else
    echo "WATASHI MANAGER"
fi
