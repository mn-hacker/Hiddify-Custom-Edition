{
	{% if hconfigs['vmess_enable'] and hconfigs['tcp_enable'] %}
		"inbounds": [
			{
				"tag":"vmess-tcp-v1",
				"listen": "127.0.0.1",
				"listen_port":2039,
				"tcp_fast_open": true,
				{# watashi v12.2.99: sniff, sniff_override_destination and domain_strategy
				   are gone from inbounds in sing-box 1.13.0+; 03_routing.json.j2 carries
				   the sniff and resolve rule actions that replace them. #}
								"type": "vmess",
				"users": [
					{% for u in users %}
						{"uuid": "{{ u['uuid'] }}", "name": "{{ u['uuid'] }}@hiddify.com", "alterId": 0},
					{% endfor%}
				],
				"transport": {
					"type": "http",
					"path": "/{{ hconfigs['path_vmess'] }}{{ hconfigs['path_tcp'] }}",
					"method":"GET",
					"idle_timeout": "115s",
					"ping_timeout": "15s"
				},
				{% include "includes/multiplex.json.pj2"%}
			}	  
		]
	{% endif %}
}