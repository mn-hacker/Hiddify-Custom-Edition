{# watashi v12.3.40dev: the old project name was taken out of this file (names, paths and links only) #}
{
	"experimental": {
		"v2ray_api": {
			"listen": "127.0.0.1:10086",
			"stats": {
				"enabled": true,
				{# watashi v12.3.42dev: the hand built sing-box inbounds are counted by tag,
				   for the traffic the Inbounds page shows per row. A ShadowTLS row
				   routes, and so counts, from its inner inbound. #}
				"inbounds": [
					{% for ci in (custom_inbounds | default([])) if ci.get('core') == 'singbox' and ci['active'] %}
					"{{ ci['tag'] }}",{% if ci['protocol'] == 'shadowtls' %} "{{ ci['tag'] }}-in",{% endif %}
					{% endfor %}
				],
				"outbounds": ["WARP","freedom","blackhole"],
				// watashi v12.2.47: sing-box counts traffic against the user *name* the
				// inbound authenticated. vless/vmess/trojan/hysteria/tuic/ss use
				// "<uuid>@watashi.cyou", but naive and mieru authenticate with the bare
				// uuid, so their traffic was never counted and those users never ran
				// out of quota. Both spellings are listed; the panel splits on "@".
				"users": [
					{% for u in users %}
						"{{ u['uuid'] }}@watashi.cyou",
						"{{ u['uuid'] }}",
					{% endfor%}
				]
			}
		},
		"clash_api": {
			"external_controller": "127.0.0.1:10087",
			"secret": ""
		},
		// watashi v12.2.99: store_warp_config and the whole monitoring block
		// only ever existed in the old custom fork. official sing-box 1.14.0
		// refuses both by name, with json: unknown field "store_warp_config"
		// and json: unknown field "monitoring".
		"cache_file": {
			"enabled": true,
			"path": "cache.db"
		}
	}
}
