{
	{% set ws_v6 = exec("[ -f /proc/net/if_inet6 ] && echo -n 'true' || echo -n 'false'")=='true' %}
		{% set ws_cert_any = exec("ls /opt/hiddify-manager/ssl/*.crt 2>/dev/null | tail -1").strip() %}
		{# watashi v12.2.100: with no certificate on the box the tls block
		   below was written with an empty path, and a missing certificate
		   is fatal for sing-box, so the whole core refused to start and
		   every config stopped answering. this listener is written only
		   when there really is a certificate to hand it. #}
		{% if hconfigs['hysteria_enable'] and ws_cert_any %}
		"inbounds": [
			{% for d in domains if d['internal_port_hysteria2']  %}
			{%set domain=d['domain']%}
			{%set port=d['internal_port_hysteria2']%}
			{
				"type": "hysteria2",
				"tag": "hysteria_in_{{port}}",
				{# watashi v12.2.100: :: cannot be bound on an ipv4 only server and the
				   core exits on it, taking every other config down with it. #}
				"listen": {% if ws_v6 %}"::"{%else%}"0.0.0.0"{%endif%},
				"listen_port": {{ port }},
				{# watashi v12.2.99: sniff, sniff_override_destination and domain_strategy
				   are gone from inbounds in sing-box 1.13.0+; 03_routing.json.j2 carries
				   the sniff and resolve rule actions that replace them. #}
								"up_mbps": {{ chconfigs[d['child_id']]['hysteria_up_mbps'] }},
				"down_mbps": {{ chconfigs[d['child_id']]['hysteria_down_mbps'] }},
				{% if chconfigs[d['child_id']]['hysteria_obfs_enable'] %}
				"obfs": {
					"type": "salamander",
				{# watashi v12.2.97: the switch above is read per node from chconfigs
				   while the password was read from hconfigs, which is always node 0.
				   on a child node the server therefore wrapped with node 0 secret while
				   the panel wrote the child own secret into the link, and every
				   hysteria2 packet was dropped. both halves read the same node now. #}
					"password": "{{ chconfigs[d['child_id']].get('hysteria_obfs_password') or chconfigs[d['child_id']]['proxy_path'] }}"
				},
				{%endif%}
				"users": [
					{% for u in users %}
						{"name": "{{ u['uuid'] }}@hiddify.com", "password": "{{ u['uuid'] }}"},
					{% endfor%}
				],
				"masquerade": "http://{{domain}}:80/",
				"tls": {
					"enabled": true,
					"server_name": "{{domain}}",
					"alpn": ["h3"],
					"min_version": "1.2",
					"max_version": "1.3",
					{% if exec("[ -f /opt/hiddify-manager/ssl/"+domain[0:64]+".crt ] && echo -n 'true' || echo -n 'false'")=='true' %}
					"certificate_path": "/opt/hiddify-manager/ssl/{{domain[0:64]}}.crt",
					"key_path": "/opt/hiddify-manager/ssl/{{domain[0:64]}}.crt.key",
					{%else %}
					{# watashi v12.2.100: an empty certificate_path is fatal ("missing
					   certificate") and one fatal inbound stops the whole core, so the
					   certificate looked up once above is reused here. #}
					{%set cert=ws_cert_any%}
					"certificate_path": "{{cert}}",
					"key_path": "{{cert}}.key",
					{%endif%}
				}
			},
			{%endfor%}
		]
	{% endif %}
}