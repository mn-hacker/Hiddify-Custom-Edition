{
	{% if hconfigs['shadowsocks2022_enable'] or hconfigs['ssfaketls_enable'] or hconfigs['shadowtls_enable'] %}
		"inbounds": [
			{
				"tag":"ss-new",
				{# watashi v12.2.100: a server with ipv6 switched off cannot bind :: at
					   all. sing-box exits on that and takes every other inbound with
					   it, which is why nothing answered on some boxes. the wildcard
					   is chosen from what this kernel really has. #}
					{% set ws_v6 = exec("[ -f /proc/net/if_inet6 ] && echo -n 'true' || echo -n 'false'")=='true' %}
					"listen": {% if hconfigs['shadowsocks2022_enable']%}{% if ws_v6 %}"::"{%else%}"0.0.0.0"{%endif%}{%else%}"127.0.0.1"{%endif%},
				"listen_port":{{hconfigs['shadowsocks2022_port']}},
				"tcp_fast_open": true,
				{# watashi v12.2.99: sniff, sniff_override_destination and domain_strategy
				   are gone from inbounds in sing-box 1.13.0+; 03_routing.json.j2 carries
				   the sniff and resolve rule actions that replace them. #}
								{% include '/opt/hiddify-manager/singbox/configs/common/protocols/ss.pj2' %},
				{% include "includes/multiplex.json.pj2"%}
			}
		]
	{% endif %}
}