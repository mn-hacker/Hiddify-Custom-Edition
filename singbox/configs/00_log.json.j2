{# watashi v12.3.40dev: the old project name was taken out of this file (names, paths and links only) #}
{
        "log": {
                {%if hconfigs['log_level']=="CRITICAL" and not hconfigs.get('user_limit_enable', False)%}
                "disabled": true,
                {%endif%}
                "level": "{% if hconfigs.get('user_limit_enable', False) and hconfigs['log_level'].lower() == 'warning' %}info{% elif hconfigs['log_level'].lower() == 'critical' %}fatal{% else %}{{hconfigs['log_level'].lower()}}{% endif %}",
                {%if hconfigs.get('access_log_enable', False) or hconfigs.get('user_limit_enable', False)%}
                "output": "/opt/watashi-manager/log/singbox.log",
                {%endif%}
                "timestamp": true
        }
}