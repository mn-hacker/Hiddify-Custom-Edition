{% set region = {
    'zh': 'cn',
    'cn': 'cn',
    'ir': 'ir',
    'ru': 'ru'
}.get(hconfigs['country'], 'cn') %}

{# watashi v12.2.129: the Nodes page decides what goes behind the node.
   Until this round the list of sites below was written into this file by
   hand and nothing could be taken out of it, which is why "the Google
   services do not come up" had no switch anywhere in the panel.
   warp_presets holds the chosen group names, comma separated, and the
   local sites group is the only one that is on by default. #}
{% set ws_groups = {
    'google':    {'geo': ['google'],
                  'dom': []},
    'ai':        {'geo': ['openai'],
                  'dom': ['openai.com', 'ai.com']},
    'streaming': {'geo': ['netflix', 'spotify', 'tiktok', 'bytedance'],
                  'dom': ['lookmovie2.to', '9anime.me', 'livechart.me', 'myanimelist.net', 'tunetank.com', 'kmplayer.com']},
    'social':    {'geo': ['reddit'],
                  'dom': ['snapchat.com', 'clubhouse.com', 'omegle.com', 'behance.net']},
    'dev':       {'geo': ['nvidia', 'unity'],
                  'dom': ['developer.mozilla.org', 'flutter.dev', 'xda-developers.com', 'gamebanana.com', 'sourcemod.net', 'alliedmods.net', 'pagespeed.web.dev', 'alldatasheet.com', 'pixelexperience.org', 'evolution-x.org', 'kenvyra.xyz', 'spark-os.live', 'pixelos.net', 'adbtc.top']},
    'tools':     {'geo': ['speedtest'],
                  'dom': ['ip.gs', 'ipinfo.io', 'freepik.com', 'flaticon.com', 'adobe.com', 'remini.com', 'giglio.com', 'homedepot.com', 'axieinfinity.com']}
} %}
{# watashi v12.2.130bo: a key that was never written still means the local
   sites group, but a key the admin emptied means no group at all. The old
   "or 'ir'" treated those two as the same thing, so unticking the last
   group switched the local sites back on behind the admin's back. The word
   none is what the Nodes page writes for an empty pick. #}
{% set ws_raw = hconfigs.get('warp_presets') %}
{% set ws_raw = 'ir' if ws_raw is none else ws_raw | string %}
{% set ws_presets = ws_raw.split(',') | map('trim') | reject('equalto', '') | reject('equalto', 'none') | list %}
{% set ws_geo = [] %}
{% set ws_dom = [] %}
{% for ws_g in ws_presets if ws_g in ws_groups %}
{% for ws_s in ws_groups[ws_g]['geo'] if ws_s not in ws_geo %}{% set ws_x = ws_geo.append(ws_s) %}{% endfor %}
{% for ws_d in ws_groups[ws_g]['dom'] if ws_d not in ws_dom %}{% set ws_x = ws_dom.append(ws_d) %}{% endfor %}
{% endfor %}
{# The local sites go THROUGH the node on purpose: the real address of this
   server must never touch an Iranian site, or that site blocks it. With the
   group switched off they are refused, exactly as when the node is off,
   never sent out directly. #}
{% set ws_local = 'ir' in ws_presets %}
{% set ws_local_out = '"forbidden_sites"' if (hconfigs['warp_mode'] == 'disable' or not ws_local) else '"WARP"' %}
{% set geo_sites = ws_geo %}
{
  "route": {
    "rule_set":[
         {
            "tag":"geoip-{{region}}",
            "type":"remote",
            "format":"binary",
            "update_interval":"1d",
            "url":"https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geoip-{{region}}.srs"
         },
         {
            "tag":"geosite-{{region}}",
            "type":"remote",
            "format":"binary",
            "update_interval":"1d",
            "url":"https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-{{region}}.srs"
         },
         {% for site in geo_sites %}
          {
            "tag":"geosite-{{site}}",
            "type":"remote",
            "format":"binary",
            "update_interval":"1d",
            "url":"https://github.com/MetaCubeX/meta-rules-dat/raw/refs/heads/sing/geo/geosite/{{site}}.srs"
         },
         {% endfor %}
         {% if hconfigs['block_ads_enable'] %}
         {
            "tag":"geosite-category-ads-all",
            "type":"remote",
            "format":"binary",
            "update_interval":"1d",
            "url":"https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-category-ads-all.srs"
         },
         {% endif %}
         {% if hconfigs['block_malware_enable'] %}
         {
            "tag":"geosite-malware",
            "type":"remote",
            "format":"binary",
            "update_interval":"1d",
            "url":"https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-malware.srs"
         },
         {
            "tag":"geosite-phishing",
            "type":"remote",
            "format":"binary",
            "update_interval":"1d",
            "url":"https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-phishing.srs"
         },
         {% endif %}
         {% if hconfigs['block_social_enable'] %}
         {
            "tag":"geosite-facebook",
            "type":"remote",
            "format":"binary",
            "update_interval":"1d",
            "url":"https://github.com/MetaCubeX/meta-rules-dat/raw/refs/heads/sing/geo/geosite/facebook.srs"
         },
         {
            "tag":"geosite-instagram",
            "type":"remote",
            "format":"binary",
            "update_interval":"1d",
            "url":"https://github.com/MetaCubeX/meta-rules-dat/raw/refs/heads/sing/geo/geosite/instagram.srs"
         },
         {
            "tag":"geosite-twitter",
            "type":"remote",
            "format":"binary",
            "update_interval":"1d",
            "url":"https://github.com/MetaCubeX/meta-rules-dat/raw/refs/heads/sing/geo/geosite/twitter.srs"
         },
         {% endif %}
         {% if hconfigs['block_nsfw_enable'] %}
         {
            "tag":"geosite-category-gambling",
            "type":"remote",
            "format":"binary",
            "update_interval":"1d",
            "url":"https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-category-gambling.srs"
         },
         {
            "tag":"geosite-nsfw",
            "type":"remote",
            "format":"binary",
            "update_interval":"1d",
            "url":"https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-nsfw.srs"
         },
         {% endif %}

    ],
    // "domainStrategy": "AsIs",
    "final": {% if hconfigs['warp_mode'] == 'all' %}"WARP"{% else %}"freedom"{% endif %},
    {# the resolve action above needs to know which server to ask. #}
    {# watashi v12.2.130bq: both of these followed the only IPv4 switch
       nowhere, which is why a site that has an AAAA record was still
       reached over IPv6 with the switch on. #}
    "default_domain_resolver": {
      "server": "cloudflare",
      "strategy": "{% if hconfigs['only_ipv4'] %}ipv4_only{% else %}prefer_ipv4{% endif %}"
    },
      "rules": [
        {# watashi v12.2.99: sniff, sniff_override_destination and
           domain_strategy were removed from inbounds in sing-box 1.13.0.
           These two actions reproduce exactly what every inbound used to
           carry. DNS is left alone on purpose: no rule ever pointed at the
           old dns outbound, so port 53 keeps going straight out. If we ever
           want the core to answer DNS itself, add a rule with
           "protocol": "dns", "action": "hijack-dns" here. #}
        {
          "action": "sniff"
        },
        {
          "action": "resolve",
          "strategy": "{% if hconfigs['only_ipv4'] %}ipv4_only{% else %}prefer_ipv4{% endif %}"
        },
        {
            "outbound": "freedom",
            "port": [53]
        },
        {
          "protocol": "quic",
          "port": [443],
          "outbound": "blackhole"
        },
        {% if hconfigs['block_ads_enable'] %}
        {
          "outbound": "blackhole",
          "rule_set": ["geosite-category-ads-all"]
        },
        {% endif %}
        {% set custom_list = hconfigs.get('block_ads_custom', '').split('\n') | map('trim') | reject('equalto', '') | list %}
        {% if custom_list %}
        {
          "outbound": "blackhole",
          "domain": [
            {% for domain in custom_list %}
            "{{ domain }}"{% if not loop.last %},{% endif %}
            {% endfor %}
          ]
        },
        {% endif %}
        {% if hconfigs['block_malware_enable'] %}
        {
          "outbound": "blackhole",
          "rule_set": ["geosite-malware", "geosite-phishing"]
        },
        {% endif %}
        {% if hconfigs['block_social_enable'] %}
        {
          "outbound": "blackhole",
          "rule_set": ["geosite-facebook", "geosite-instagram", "geosite-twitter"]
        },
        {% endif %}
        {% if hconfigs['block_nsfw_enable'] %}
        {
          "outbound": "blackhole",
          "rule_set": ["geosite-category-gambling", "geosite-nsfw"]
        },
        {% endif %}
        {
            "outbound": {{ ws_local_out }},
             "rule_set":[
              "geoip-{{region}}", "geosite-{{region}}"
             ]
        },
        {% if hconfigs['warp_mode'] != 'disable' %}
          {% if ws_geo %}
          {
              "outbound": "WARP",
              "rule_set":[
                {% for site in ws_geo %}
                  "geosite-{{site}}",
                {% endfor %}
              ]
          },
          {% endif %}
          {% if ws_dom %}
          {
              "outbound": "WARP",
              "domain_suffix":[
                {% for ws_d in ws_dom %}
                  "{{ws_d}}",
                {% endfor %}
              ]
          },
          {% endif %}
          {% set warp_sites = hconfigs.get('warp_sites','').split('\n') | map('trim') | reject('equalto', '') | list %}
          {% if warp_sites %}
          {
              "outbound": "WARP",
              "domain":[                
                    {%for d in warp_sites %}
                        "{{d}}"{% if not loop.last %},{% endif %}
                    {% endfor %}
              ]
          },
          {% endif %}
        {% endif %}
        {
          "outbound": "blackhole", "ip_is_private": true
        }
        // {// Block BitTorrent protocol
        //   "type": "field", "outboundTag": "blackhole", "protocol": ["bittorrent"]
        // },
      ]
    }
  

}
