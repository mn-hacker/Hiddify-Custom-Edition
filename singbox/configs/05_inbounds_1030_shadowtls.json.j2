{
	{% if hconfigs['shadowtls_enable'] %}
		"inbounds": [
			{
				"tag":"shadowtls",
				"listen": "127.0.0.1",
				"listen_port":1030,
				"detour":"ss-new",
				"tcp_fast_open": true,
				{# watashi v12.2.99: sniff, sniff_override_destination and domain_strategy
				   are gone from inbounds in sing-box 1.13.0+; 03_routing.json.j2 carries
				   the sniff and resolve rule actions that replace them. #}
								"type": "shadowtls",
				"version":3,
				"users": [
					{"password": "{{ hconfigs['shared_secret'] }}"},
				],
				"handshake": {
					"server": "{{hconfigs['shadowtls_fakedomain']}}",
					"server_port": 443
				},
				"handshake_for_server_name": {
					"{{hconfigs['shadowtls_fakedomain']}}": {
						"server": "{{hconfigs['shadowtls_fakedomain']}}",
						"server_port": 443
					}
				},
				"strict_mode":false,
			}	
		]
	{% endif %}
}