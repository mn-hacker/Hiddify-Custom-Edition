[Unit]
Description=hiddify panel background tasks
After=network-online.target hiddify-redis.service
Wants=network-online.target hiddify-redis.service
# watashi: v12.2.46 - BindsTo stopped the worker for good whenever redis
# blinked, and usage counting stops with it. Wants= above is enough.
# watashi v12.3.35dev: 0/0 meant no start limit at all. The worker dies in
# ~10s on any startup error (kombu VersionMismatch with redis-py 5.2.0 was the
# real case), Restart=always brings it back 5s later, and create_app alone
# costs ~9s of CPU, so a 1-vCPU VPS sat at 100% forever (782+ restarts).
# 5 starts in 2 minutes still rides out a real transient (redis coming up
# late) but parks the unit in failed on a code error. The installer and
# restart.sh run reset-failed before restarting it.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=hiddify-panel
WorkingDirectory=/opt/hiddify-manager/hiddify-panel/
Environment="LANG=C.UTF-8"
ExecStart=/opt/hiddify-manager/.venv313/bin/python -c "from hiddifypanel.base import create_app; app=create_app(); celery=app.extensions['celery']; celery.worker_main(['worker', '--beat', '--loglevel=info', '--concurrency=1', '--pool=solo'])"
# watashi v12.3.35dev: guarded like hiddify-panel.service. After a crash
# MAINPID is empty, the bare kill failed, and every cycle logged "Referenced
# but unset environment variable ... MAINPID" plus a FAILURE of its own.
ExecReload=/bin/bash -c 'test -n "$MAINPID" && kill -HUP $MAINPID || true'
RestartSec=5
ExecStop=/bin/bash -c 'test -n "$MAINPID" && kill -INT $MAINPID || true'
Restart=always
# watashi v12.3.35dev: file: truncated both logs on every start, so after a
# crash loop the real error (VersionMismatch) was already gone. append: keeps it.
StandardOutput=append:/opt/hiddify-manager/log/system/hiddify_panel_background_tasks.out.log
StandardError=append:/opt/hiddify-manager/log/system/hiddify_panel_background_tasks.err.log
[Install]
WantedBy=multi-user.target
