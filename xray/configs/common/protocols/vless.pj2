{# watashi v12.3.40dev: the old project name was taken out of this file (names, paths and links only) #}
"protocol": "vless",
"settings": {
    "clients": [
        {% for u in users %}
            {
                "id": "{{ u['uuid'] }}", 
                "email": "{{ u['uuid'] }}@watashi.cyou",
                "flow": "{{flow}}"
            },
        {% endfor %}
    ],
    "decryption": "none",
    "fallbacks": [   
        {
            "dest": "@@http_in_h2", //redirect to haproxy
            "xver": 2
        }
    ]
}