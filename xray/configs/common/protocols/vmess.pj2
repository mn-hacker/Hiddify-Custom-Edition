"protocol": "vmess",
"settings": {
    "clients": [
        {% for u in users %}
            {"id": "{{ u['uuid'] }}", "email": "{{ u['uuid'] }}@watashi.cyou", "alterId": 0},
        {% endfor %}
    ]
}