{
  "outbounds": [
    {
      {%if hconfigs["only_ipv4"]%}
      "domainStrategy":"UseIPv4v6",
      {%endif%}
      "tag": "freedom",
      "protocol": "freedom",
      "settings": {

      },
      "streamSettings": {
        "sockopt": {
          "tcpFastOpen": true,
          "tcpKeepAliveInterval": 30,
          "tcpNoDelay": true
        }
      }
    },
    {
      {% if ws_warp_ipv is defined and ws_warp_ipv == '4' %}
      // watashi v12.2.130bf: the engine cannot decide this, only we can. Its -4
      // flag picks the cloudflare address to dial; the tunnel behind it
      // always holds a v4 and a v6 address, so a name sent through as a
      // name comes back AAAA and the user leaves on IPv6. Resolved here,
      // the tunnel is handed a literal IPv4 and has nothing to choose.
      "domainStrategy": "UseIPv4",
      {% elif ws_warp_ipv is defined and ws_warp_ipv == '6' %}
      "domainStrategy": "UseIPv6",
      {% endif %}
      "tag": "WARP",
      "protocol": "socks",
      "settings": {
        "servers": [
          {
            "address": "127.0.0.1",
            "port": 3000
          }
        ]
      }
    },
    // Old WireGuard interface mode (requires wg-quick@warp):
    // {
    //   {%if hconfigs["only_ipv4"]%}
    //   "domainStrategy":"UseIPv4v6",
    //   {%endif%}
    //   "tag": "WARP",
    //   "protocol": "freedom",
    //   "streamSettings": {
    //     "sockopt": {
    //       "tcpFastOpen": true,
    //       "interface": "warp"
    //     }
    //   }
    // },
    {
      "protocol": "blackhole",
      "tag": "blackhole"
    },
    { //do not change the following line since it will be replaced.
      "tag": "forbidden_sites",
      "protocol": "{% if hconfigs['block_iran_sites'] %}blackhole{% else %}freedom{%endif%}"
    },
