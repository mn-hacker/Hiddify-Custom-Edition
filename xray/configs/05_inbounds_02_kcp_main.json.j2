{
    {% if hconfigs['vless_enable'] and hconfigs['kcp_enable'] %}
        "inbounds": [
            {
                "tag":"kcp",
                "port": {{ hconfigs['kcp_ports'] or '88'}}, //xbox port
                "listen":"127.0.0.1",
                "protocol": "vless",
                "settings": {
                "clients": [
                {% for u in users %}
                    {"id": "{{ u['uuid'] }}", "email": "{{ u['uuid'] }}@hiddify.com"},
                {% endfor %}
                ],
                "decryption": "none",
                "fallbacks": [
                    {
                        "dest": "@dispatcher",
                        "xver": 2
                    }
                ]
                },
                "streamSettings": {
                    "network": "kcp",
                    // watashi v12.2.75: the "seed" and "header" fields were
                    // removed from mKCP in Xray-core. Setting either one now fails
                    // at config build, which means the core refuses to start at all
                    // rather than warning. Both sides fall back to core defaults, so
                    // they still agree. Masking moves to FinalMask in a later round.
                    "kcpSettings": {}
                }
            }
        ]
    {% endif %}
}